/sites
/cli
/desktop
# ...except the workspace manifests, which the deps stage needs
!/sites/*/package.json
!/desktop/package.json
# go backend (.dockerignore has no inline comments)
/backend

# Build output and installed deps. The Dockerfile builds its own; sending the
# host's along only makes the context gigabytes larger (cargo targets alone
# are several GB) and risks stale copies landing in the image.
**/node_modules
**/target
/target-container
**/.output
**/.nuxt
**/.nitro
**/.cache
*.AppImage
/drop-custom.tar.gz

# Generated in the image's own codegen layer
/server/prisma/client
/server/server/internal/proto

# Version control: the image build gets its version and git ref as build args
/.git

# Local-only state: the dev library link and env files with secrets
**/.data
**/.env
**/.env.*
!**/.env.example
