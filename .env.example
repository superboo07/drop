# Per-machine settings for the devcontainer. Copy to `.env` at the top of the
# repository (NOT inside .devcontainer/) and fill in paths on your machine.
# `.env` is gitignored (`*.env`); devcontainer.json links it beside the compose
# file on the host before the container starts. Rebuild after changing it.
#
# (This is not server/.env: that one configures the Drop server itself --
# database URL, metadata API keys -- see server/.env.example.)

# Your game library, laid out as /{game name}/{version name}/... (see
# server/server/internal/library/README.md). Mounted read-only at this same
# path inside the container; post-create links server/.data/library to it,
# which is where `pnpm dev` looks by default. Optional: without it the server
# runs with an empty library.
DROP_LIBRARY_DIR=

# `ro` (default) or `rw`. Leave it read-only unless you know a tool must write
# into the library -- inputs are never outputs.
#DROP_MOUNT_MODE=ro
