enum ClientCapabilities {
  PeerAPI       @map("peerAPI") // other clients can use the HTTP API to P2P with this client
  UserStatus    @map("userStatus") // this client can report this user's status (playing, online, etc etc)
  CloudSaves    @map("cloudSaves") // ability to save to save slots
  TrackPlaytime @map("trackPlaytime") // ability to track user playtime
  ClientLogs    @map("clientLogs") // ability to upload its logs for admins to read
}

// References a device
model Client {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  capabilities ClientCapabilities[]

  name          String
  platform      Platform
  lastConnected DateTime

  lastAccessedSaves SaveSlot[]
  tokens            APIToken[]
  playtimeSessions  PlaytimeSession[]
  logBundles        ClientLogBundle[]
}

// What kind of desktop client build a release is. Each target has its own
// installer strategy on the client; add new ones (e.g. a Windows installer)
// here and in server/internal/clientreleases.
enum ClientReleaseTarget {
  LinuxAppImage @map("linux-appimage")
}

// Clients on the release branch are only offered release builds; clients on
// the test branch are offered the newest build from either branch.
enum ClientReleaseBranch {
  Release @map("release")
  Test    @map("test")
}

enum ClientReleaseArch {
  x86_64
  aarch64
}

// A desktop client build uploaded through Admin > Clients > Updater. The id
// is the release's identity; `tag` is only what people see, and may repeat
// (e.g. a withdrawn or deleted build re-uploaded under the same tag).
model ClientRelease {
  id     String              @id @default(uuid())
  tag    String
  target ClientReleaseTarget
  arch   ClientReleaseArch
  branch ClientReleaseBranch @default(Release)

  notes    String  @default("") @db.Text // Markdown
  required Boolean @default(false) // client can't dismiss the update prompt

  fileName String
  size     BigInt
  sha256   String

  uploadedAt  DateTime  @default(now())
  publishedAt DateTime? // null while a draft
  withdrawnAt DateTime?

  uploaderId    String?
  uploader      User?   @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  // Name of the API token used, when a token uploaded it instead of a user.
  // Copied rather than related so it outlives the token.
  uploaderToken String?

  @@index([target, arch])
  @@index([sha256])
}

// Why a client sent a log bundle
enum ClientLogTrigger {
  Manual       @map("manual") // someone pressed "Send logs" in the client
  Crash        @map("crash") // the client panicked; sent on its next start
  LaunchFailed @map("launch") // a game exited with an error or right after starting
}

// Logs a desktop client uploaded, browsed in Admin > Clients > Logs. The
// files themselves live on disk (server/internal/clientlogs); this row holds
// what the list and detail pages show without reading them.
model ClientLogBundle {
  id String @id @default(uuid())

  // Copied rather than only related, so a bundle outlives its client
  clientId   String?
  client     Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName String
  userName   String

  trigger ClientLogTrigger
  version String // client version, e.g. "0.4.0-gecbf8566"
  arch    String // "x86_64", "aarch64"
  session String // e.g. "gamescope", "KDE (wayland)"

  gameId   String?
  gameName String?

  // { title, detail?, lastError? } - what went wrong, when the client knows
  summary     Json?
  // [[name, value, flagged]] - selected environment variables at startup
  environment Json  @default("[]")
  // [{ name, label, path, size, errors, warnings, truncated }], index = file on disk
  files       Json  @default("[]")

  errors   Int @default(0)
  warnings Int @default(0)
  size     Int @default(0) // bytes on disk

  receivedAt DateTime @default(now())

  @@index([receivedAt])
  @@index([clientId])
}
